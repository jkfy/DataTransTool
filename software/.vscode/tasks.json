{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Qt Project",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Clean Qt Project",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Rebuild Qt Project",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--clean-first"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Clean Qt Project",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run Qt App",
            "type": "shell",
            "command": "${command:cmake.launchTargetPath}",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "D:/QtCreate/6.10.0/mingw_64/bin;${env:PATH}"
                }
            },
            "dependsOn": "Build Qt Project",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}