  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff,
        stop:0.42 #f7fbff,
        stop:1 #d3e7fc);
}
QWidget#centralwidget { background: transparent; }
QGroupBox {
    font-weight: 600;
    border: 1px solid #c9def5;
    border-radius: 10px;
    margin-top: 12px;
    padding: 16px 14px 14px 14px;
    background: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 2px 10px;
    color: #1c4f86;
    background-color: #e8f4ff;
    border-radius: 6px;
}
QLineEdit, QListWidget, QPlainTextEdit, QComboBox {
    border: 1px solid #c7dcf2;
    border-radius: 7px;
    padding: 7px;
    background: #ffffff;
    color: #22384f;
    selection-background-color: #cfe6ff;
    selection-color: #17375e;
}
QLineEdit:focus, QListWidget:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 1px solid #6aa9e8;
}
QComboBox {
    padding-right: 26px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #c7dcf2;
    selection-background-color: #d8ecff;
    selection-color: #17375e;
    outline: none;
}
QPushButton {
    border: 1px solid #bcd8f3;
    border-radius: 7px;
    padding: 7px 13px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff,
        stop:1 #eaf5ff);
    color: #1d4f7a;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f8fcff,
        stop:1 #69b4fa);
    border-color: #8fc5f0;
}
QPushButton:pressed {
    background: #cfe6fa;
    border-color: #6aa9e8;
}
QPushButton:disabled {
    color: #9db2c6;
    background: #f3f7fb;
    border-color: #dce8f3;
}
QPushButton#startButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4c9af5,
        stop:1 #578bfa);
    color: #ffffff;
    border-color: #2563eb;
    font-weight: 600;
}
QPushButton#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #66adff,
        stop:1 #3478ed);
}
QPushButton#startButton:pressed { background: #1d4ed8; }
QPushButton#startButton:disabled {
    background: #b7d4f5;
    border-color: #b7d4f5;
    color: #f0f7ff;
}
QProgressBar {
    border: 1px solid #c7dcf2;
    border-radius: 8px;
    height: 20px;
    text-align: center;
    background: #edf6ff;
    color: #1d4f7a;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #8bc3fc,
        stop:1 #2563eb);
    border-radius: 7px;
}
QCheckBox { color: #274a69; spacing: 6px; }
QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background: #d8ecff;
    color: #17375e;
}
QListWidget::item:hover { background: #eef7ff; }
QLabel#titleLabel { color: #17375e; }
QLabel#subtitleLabel, QLabel#inputHintLabel, QLabel#outputHintLabel {
    color: #5f7f9f;
}
QStatusBar {
    background: #f2f9ff;
    color: #4a6b88;
}</string>
