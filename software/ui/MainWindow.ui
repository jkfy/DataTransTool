  <property name="styleSheet">
   <string notr="true">QMainWindow { background: #f4f6fa; }
QGroupBox {
    font-weight: 600;
    border: 1px solid #d8dee8;
    border-radius: 8px;
    margin-top: 10px;
    padding: 14px 12px 12px 12px;
    background: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #1f2d3d;
}
QLineEdit, QListWidget, QPlainTextEdit {
    border: 1px solid #cfd7e3;
    border-radius: 6px;
    padding: 6px;
    background: #ffffff;
    selection-background-color: #bfdbfe;
}
QPushButton {
    border: 1px solid #cfd7e3;
    border-radius: 6px;
    padding: 7px 14px;
    background: #ffffff;
}
QPushButton:hover { background: #eef4ff; }
QPushButton:disabled { color: #9aa4b2; background: #f3f5f8; }
QPushButton#startButton {
    background: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
    font-weight: 600;
}
QPushButton#startButton:hover { background: #1d4ed8; }
QPushButton#startButton:disabled { background: #9db7ee; border-color: #9db7ee; }
QProgressBar {
    border: 1px solid #d8dee8;
    border-radius: 6px;
    height: 20px;
    text-align: center;
    background: #ffffff;
}
QProgressBar::chunk { background: #2563eb; border-radius: 5px; }
QLabel#subtitleLabel, QLabel#inputHintLabel, QLabel#outputHintLabel {
    color: #6b7785;
}</string>
