  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f8fcff,
        stop:0.42 #ddefff,
        stop:1 #b9dcfb);
}
QWidget#centralwidget { background: transparent; }
QGroupBox {
    font-weight: 600;
    border: 1px solid #d6e6f5;
    border-radius: 12px;
    margin-top: 12px;
    padding: 16px 14px 14px 14px;
    background: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 2px 10px;
    color: #1c4f86;
    background-color: #eaf5ff;
    border-radius: 6px;
}
QLineEdit, QListWidget, QPlainTextEdit, QComboBox {
    border: 1px solid #c9dff2;
    border-radius: 7px;
    padding: 7px;
    background: #ffffff;
    color: #22384f;
    selection-background-color: #d8ecff;
    selection-color: #17375e;
}
QLineEdit:focus, QListWidget:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 1px solid #4aa4e8;
}
QComboBox {
    padding-right: 26px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #c9dff2;
    selection-background-color: #d8ecff;
    selection-color: #17375e;
    outline: none;
}
QPushButton {
    border: 1px solid #c4dcf0;
    border-radius: 7px;
    padding: 7px 13px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff,
        stop:1 #eef8ff);
    color: #2b6da5;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f8fcff,
        stop:1 #a9d8ff);
    border-color: #7fc2f5;
}
QPushButton:pressed {
    background: #cfe9ff;
    border-color: #4aa4e8;
}
QPushButton:disabled {
    color: #9db2c6;
    background: #f3f7fb;
    border-color: #dce8f3;
}
QPushButton#startButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #57b6ff,
        stop:1 #2678df);
    color: #ffffff;
    border-color: #2678df;
    font-weight: 600;
}
QPushButton#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #74ccff,
        stop:1 #2b86ee);
}
QPushButton#startButton:pressed { background: #1c68c9; }
QPushButton#startButton:disabled {
    background: #b7d4f5;
    border-color: #b7d4f5;
    color: #f0f7ff;
}
QProgressBar {
    border: 1px solid #c9def2;
    border-radius: 8px;
    height: 20px;
    text-align: center;
    background: #eaf5ff;
    color: #1d4f7a;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #74ccff,
        stop:1 #2b86ee);
    border-radius: 7px;
}
QCheckBox { color: #3f5f7b; spacing: 6px; }
QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background: #d8ecff;
    color: #17375e;
}
QListWidget::item:hover { background: #eef7ff; }
QLabel#titleLabel {
    color: #123a5e;
    font-size: 20px;
}
QLabel#subtitleLabel { color: #6c7f91; }
QLabel#inputHintLabel, QLabel#outputHintLabel { color: #8296a9; }
QStatusBar {
    background: #f2f9ff;
    color: #4a6b88;
}
QFrame#headerPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fffdf8,
        stop:1 #fbf7ee);
    border: 1px solid #e8dfcf;
    border-radius: 12px;
}
QFrame#headerPanel QLabel#titleLabel { color: #123a5e; }
QFrame#headerPanel QLabel#subtitleLabel { color: #6c7f91; }
</string>
